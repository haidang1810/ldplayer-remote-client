# Copy to agent.env on the LDPlayer PC and fill in.
RELAY_URL=wss://remote.example.com
AGENT_KEY=paste-the-key-printed-by-relay-setup
# Name shown in the web UI when several PCs are connected (default: Windows computer name)
# AGENT_NAME=topgroup

# Stream quality (lower these for 4G): bit rate, longest side in pixels (0 = native), fps cap
# BIT_RATE=6M
# MAX_SIZE=1280   (default; 0 = native 900x1600, sharper but ~42 fps with the emulator software encoder)
# MAX_FPS=60

# Spread key-frame packets over time (helps bursty loss on weak links, adds ~35 ms latency). 0 = off
# PACING_FACTOR=4
